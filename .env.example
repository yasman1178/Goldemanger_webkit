# ============ بيئة الإنتاج (Vercel) — تُترك فارغاً ============
# الموقع المنشور يعمل عبر وسيط Vercel Proxy (يراجع vercel.json):
#   /api/*  و /uploads/*  تُمرَّر تلقائياً إلى https://goldmaster.runasp.net/
# لذلك VITE_API_URL تُترك فارغة في Vercel ليعمل الـ Requests بنفس الأوريغين (HTTPS)
# وتتجنب Mixed Content و CORS. إن احتجت الاتصال المباشر فاستخدم https:// فقط:
#   VITE_API_URL=https://goldmaster.runasp.net/
VITE_API_URL=

# ============ التطوير المحلي ============
# أنشئ نسخة من هذا الملف باسم .env.local ولا ترفعها، وضعه على عنوان الباك إند المحلي:
#   VITE_API_URL=http://localhost:5086/

# رابط الموقع النهائي — يُضبط في Vercel Dashboard (مثال: https://goldemanger-webkit.vercel.app)
# يُستخدم في canonical / og:url / sitemap / og:image.
VITE_SITE_URL=