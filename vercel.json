{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://goldmaster.runasp.net/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://goldmaster.runasp.net/uploads/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
